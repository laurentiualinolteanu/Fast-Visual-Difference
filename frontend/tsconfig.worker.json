/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/worker",
    /* ES2022 to match tsconfig.json's target. The CLI scaffolds "es2018" here, which
       silently gives the worker a smaller standard library than the app: code using
       Array.prototype.at/flat compiles under tsconfig.app.json and fails here. The
       whole diff engine is imported by the worker, so the two must agree. */
    "lib": [
      "ES2022",
      "webworker"
    ],
    "types": []
  },
  /* The engine is listed explicitly, not left to be pulled in through the worker's
     imports. Until the worker actually imports it (T10) this config would otherwise
     compile the placeholder alone and prove nothing — while still exiting 0, which
     makes it worse than no check at all.

     With "lib" holding no DOM entry and "types" empty, this is a compile-time proof
     that core/diff touches neither the DOM nor Angular. Specs are excluded: they use
     Jasmine globals, which are a test concern rather than an engine dependency. */
  "include": [
    "src/**/*.worker.ts",
    "src/app/core/diff/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
